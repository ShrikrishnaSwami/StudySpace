# Public browser configuration. These values are not secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alternatively configure NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional: set to true to enable slower semantic retrieval enrichment; lexical retrieval is the default.
STUDYSPACE_SEMANTIC_RETRIEVAL=false
STUDYSPACE_EMBEDDING_MODEL=gemini-embedding-001

# Optional task-specific Gemini model routing. Defaults are supplied by the app.
GEMINI_MODEL=
GEMINI_TUTOR_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_FAST_MODEL=
GEMINI_FALLBACK_MODEL=

# Optional free cloud AI providers. Keep these keys server-only.
# Groq free developer tier (subject to model-specific rate limits).
GROQ_API_KEY=
# Enable only after reviewing Groq terms and enabling Zero Data Retention in its console.
GROQ_ALLOW_STUDENT_DATA=false
GROQ_MODEL=
GROQ_MODEL_TUTOR=
GROQ_MODEL_QUIZ=
GROQ_MODEL_FLASHCARDS=
GROQ_MODEL_HOMEWORK=
GROQ_MODEL_SYLLABUS=
GROQ_MODEL_RECOMMENDATIONS=
GROQ_MODEL_NOTES=
GROQ_MODEL_GRADING=

# OpenRouter free-model routing. Use "openrouter/free" or a model ID ending in :free.
# StudySpace rejects non-free OpenRouter model IDs.
OPENROUTER_API_KEY=
# OpenRouter free endpoints may log or use prompts under model-provider terms. Leave false for student data.
OPENROUTER_ALLOW_STUDENT_DATA=false
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_TUTOR=
OPENROUTER_MODEL_QUIZ=
OPENROUTER_MODEL_FLASHCARDS=
OPENROUTER_MODEL_HOMEWORK=
OPENROUTER_MODEL_SYLLABUS=
OPENROUTER_MODEL_RECOMMENDATIONS=
OPENROUTER_MODEL_NOTES=
OPENROUTER_MODEL_GRADING=

# Choose the preferred provider per workload. Unconfigured providers are skipped.
# Valid values: gemini, groq, openrouter. Defaults to Gemini.
AI_PROVIDER_TUTOR=gemini
AI_PROVIDER_REASONING=groq
AI_PROVIDER_FAST=groq

# Optional canonical origin used for API origin checks.
APP_ORIGIN=https://www.studyspace.wiki

