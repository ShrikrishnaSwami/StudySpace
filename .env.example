# Public browser configuration. These values are not secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional: set to false to use lexical-only AI tutor retrieval.
STUDYSPACE_SEMANTIC_RETRIEVAL=true
STUDYSPACE_EMBEDDING_MODEL=gemini-embedding-001

# Optional task-specific Gemini model routing. Defaults are supplied by the app.
GEMINI_MODEL=
GEMINI_TUTOR_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_FAST_MODEL=
GEMINI_FALLBACK_MODEL=

# Optional alternative providers; add real keys only in server-side deployment settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER_TUTOR=gemini
AI_PROVIDER_REASONING=gemini
AI_PROVIDER_FAST=gemini
OPENAI_MODEL=
OPENAI_TUTOR_MODEL=
OPENAI_REASONING_MODEL=
OPENAI_FAST_MODEL=
ANTHROPIC_MODEL=
ANTHROPIC_TUTOR_MODEL=
ANTHROPIC_REASONING_MODEL=
ANTHROPIC_FAST_MODEL=

# Optional canonical origin used for API origin checks.
APP_ORIGIN=https://www.studyspace.wiki

# Set in the deployment environment to the verified owner email.
STUDYSPACE_ADMIN_EMAIL=
